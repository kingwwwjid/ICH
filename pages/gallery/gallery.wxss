.tabs {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #333;
  border-bottom: 4rpx solid transparent;
}
.tab.active {
  color: #cc0000;
  border-bottom-color: #cc0000;
}
.list { padding: 24rpx; }
.g-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  padding: 20rpx;
}
.g-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}
.g-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.g-name { font-size: 32rpx; font-weight: bold; color: #333; }
.g-intro { font-size: 26rpx; color: #666; margin-top: 12rpx; }
