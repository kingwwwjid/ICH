.list {
  padding: 24rpx;
}
.act-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  padding: 20rpx;
}
.act-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}
.act-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.act-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.act-time, .act-loc {
  font-size: 26rpx;
  color: #666;
}
