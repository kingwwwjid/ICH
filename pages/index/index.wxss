.banner {
  width: 100%;
  height: 360rpx;
}
.banner-img {
  width: 100%;
  height: 360rpx;
}
.nav {
  display: flex;
  padding: 24rpx 0;
  background: #fff;
}
.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;   /* 图标和文字竖着排 */
  align-items: center;      /* 水平居中 */
}
.nav-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;       /* 圆形图标 */
}
.nav-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #333;
}
.section {
  margin-top: 20rpx;
  background: #fff;
  padding: 24rpx;
}
.sec-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.sec-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.sec-more {
  font-size: 26rpx;
  color: #999;
}
.act-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.act-cell {
  width: 48%;
  margin-bottom: 24rpx;
}
.act-img {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
}
.act-name {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #333;
}



