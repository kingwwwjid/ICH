.banner {
  width: 100%;
  height: 360rpx;
}
.banner-img {
  width: 100%;
  height: 360rpx;
}
.nav {
  display: flex;
  padding: 24rpx 0;
  background: #fff;
}
.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;   /* 图标和文字竖着排 */
  align-items: center;      /* 水平居中 */
}
.nav-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;       /* 圆形图标 */
}
.nav-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #333;
}

